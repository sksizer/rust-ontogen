/// End a `match_changes_subscribe` subscription. Returns `false` when it already ended.
#[::tauri::command]
pub fn match_changes_unsubscribe(id: u64) -> bool {
    EVENT_SUBSCRIPTIONS.cancel(id)
}

// ── Event Forwarding (global) ──

/// Emit every parameterless event stream to all windows as a Tauri event.
/// Call this during app setup. Prefer the per-subscriber `*_subscribe`
/// commands, which report lag to the subscriber and end with it.
pub fn start_event_forwarding(app_handle: ::tauri::AppHandle, state: &AppState) {
    // log_changes
    {
        let handle = app_handle.clone();
        let mut rx = crate::api::v1::log::log_changes(state);
        ::tauri::async_runtime::spawn(async move {
            loop {
                match rx.recv().await {
                    Ok(delta) => {
                        if let Err(e) = ::tauri::Emitter::emit(&handle, "log-changes", &delta) {
                            ::log::error!("Failed to forward log-changes to IPC: {:?}", e);
                        }
                    }
                    Err(::tokio::sync::broadcast::error::RecvError::Lagged(skipped)) => {
                        ::log::warn!("log-changes forwarding lagged; {} events dropped", skipped);
                    }
                    Err(::tokio::sync::broadcast::error::RecvError::Closed) => break,
                }
            }
        });
    }
    // match_changes
    {
        let handle = app_handle.clone();
        let mut rx = crate::api::v1::r#match::match_changes(state);
        ::tauri::async_runtime::spawn(async move {
            loop {
                match rx.recv().await {
                    Ok(delta) => {
                        if let Err(e) = ::tauri::Emitter::emit(&handle, "match-changes", &delta) {
                            ::log::error!("Failed to forward match-changes to IPC: {:?}", e);
                        }
                    }
                    Err(::tokio::sync::broadcast::error::RecvError::Lagged(skipped)) => {
                        ::log::warn!("match-changes forwarding lagged; {} events dropped", skipped);
                    }
                    Err(::tokio::sync::broadcast::error::RecvError::Closed) => break,
                }
            }
        });
    }
}
/// Generated IPC handler. Wire this into `tauri::Builder::invoke_handler()`.
pub fn ipc_handler() -> impl Fn(::tauri::ipc::Invoke) -> bool + Send + Sync + 'static {
    ::tauri::generate_handler![
        arc_get,
        future_list,
        lookup_find_docs,
        match_list,
        match_get_by_id,
        match_create,
        match_update,
        match_delete,
        state_list,
        state_get_by_id,
        state_create,
        state_update,
        state_delete,
        value_list,
        value_get_by_id,
        value_create,
        value_update,
        value_delete,
        arc_changes_subscribe,
        arc_changes_unsubscribe,
        log_changes_subscribe,
        log_changes_unsubscribe,
        match_changes_subscribe,
        match_changes_unsubscribe,
    ]
}
