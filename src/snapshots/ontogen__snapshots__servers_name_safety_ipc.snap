    )))
}

/// End a `log_changes_subscribe` subscription. Returns `false` when it already ended.
#[::tauri::command]
pub fn log_changes_unsubscribe(id: u64) -> bool {
    EVENT_SUBSCRIPTIONS.cancel(id)
}

#[::tauri::command]
pub async fn match_changes_subscribe(
    channel: ::tauri::ipc::Channel<::ontogen_core::events::EventFrame<Match>>,
