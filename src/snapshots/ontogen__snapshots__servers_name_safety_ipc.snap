#[derive(::serde::Serialize)]
pub struct PaginatedResult<T: ::serde::Serialize> {
    pub items: Vec<T>,
    pub total: u64,
    pub limit: u32,
    pub offset: u32,
}

// ── Arc IPC Commands ──

#[::tauri::command]
pub async fn arc_get(
    r#in: String,
    ontogen_state: ::tauri::State<'_, ::std::sync::Arc<AppState>>,
) -> Result<Arc, String> {
    let ontogen_store = ontogen_state.store().await.map_err(|ontogen_e| ontogen_e.to_string())?;
    arc::get(&ontogen_store, &r#in).await.map_err(|ontogen_e| ontogen_e.to_string())
}

// ── Future IPC Commands ──

#[::tauri::command]
pub async fn future_list(
    r#type: Option<String>,
    limit: Option<u32>,
    offset: Option<u32>,
    ontogen_state: ::tauri::State<'_, ::std::sync::Arc<AppState>>,
) -> Result<PaginatedResult<Future>, String> {
    let ontogen_store = ontogen_state.store().await.map_err(|ontogen_e| ontogen_e.to_string())?;
    let ontogen_limit = limit.unwrap_or(20).min(100);
    let ontogen_offset = offset.unwrap_or(0);
    let ontogen_items = future::list(
        &ontogen_store,
        r#type.as_deref(),
        Some(u64::from(ontogen_limit)),
        Some(u64::from(ontogen_offset)),
    )
    .await
    .map_err(|ontogen_e| ontogen_e.to_string())?;
    let ontogen_total =
        future::count(&ontogen_store, r#type.as_deref()).await.map_err(|ontogen_e| ontogen_e.to_string())?;
    Ok(PaginatedResult { items: ontogen_items, total: ontogen_total, limit: ontogen_limit, offset: ontogen_offset })
}

