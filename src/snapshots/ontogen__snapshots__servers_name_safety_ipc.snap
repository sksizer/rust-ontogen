// ── Event Subscriptions ──

/// Live IPC event subscriptions, by id. A process-wide static rather than
/// consumer state: an id only means something to the process that issued it,
/// and the consumer has nothing to wire. A forwarding task leaves it when its
/// receiver closes, when a `Channel::send` fails (the webview is gone; a
/// `Channel` has no close callback), or on an explicit unsubscribe.
static EVENT_SUBSCRIPTIONS: ::ontogen_core::events::Subscriptions = ::ontogen_core::events::Subscriptions::new();

#[::tauri::command]
pub async fn arc_changes_subscribe(
    r#in: Option<String>,
    channel: ::tauri::ipc::Channel<::ontogen_core::events::EventFrame<Arc>>,
    ontogen_state: ::tauri::State<'_, ::std::sync::Arc<AppState>>,
) -> Result<u64, String> {
    let ontogen_rx = arc::arc_changes(&ontogen_state, r#in);
    Ok(EVENT_SUBSCRIPTIONS.spawn(::ontogen_core::events::forward(
        ontogen_rx,
        ::ontogen_core::events::no_id,
        move |ontogen_frame| channel.send(ontogen_frame),
    )))
}

/// End a `arc_changes_subscribe` subscription. Returns `false` when it already ended.
#[::tauri::command]
pub fn arc_changes_unsubscribe(id: u64) -> bool {
    EVENT_SUBSCRIPTIONS.cancel(id)
}

#[::tauri::command]
pub async fn log_changes_subscribe(
    channel: ::tauri::ipc::Channel<::ontogen_core::events::EventFrame<Log>>,
    ontogen_state: ::tauri::State<'_, ::std::sync::Arc<AppState>>,
) -> Result<u64, String> {
    let ontogen_rx = log::log_changes(&ontogen_state);
    Ok(EVENT_SUBSCRIPTIONS.spawn(::ontogen_core::events::forward(
        ontogen_rx,
        ::ontogen_core::events::no_id,
