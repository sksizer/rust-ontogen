/// Partial update for a Node. Only `Some` values are applied.
#[derive(Debug, Clone, Default)]
pub struct NodeUpdate {
    pub label: Option<String>,
    pub parent_id: Option<Option<String>>,
    pub contains: Option<Vec<String>>,
    pub body: Option<String>,
}

impl NodeUpdate {
    fn apply(&self, record: &mut Node) {
        if let Some(value) = &self.label {
            record.label.clone_from(value);
        }
        if let Some(value) = &self.parent_id {
            record.parent_id.clone_from(value);
        }
        if let Some(value) = &self.contains {
            record.contains.clone_from(value);
        }
        if let Some(value) = &self.body {
            record.body.clone_from(value);
        }
    }
}

impl From<crate::schema::UpdateNodeInput> for NodeUpdate {
    fn from(input: crate::schema::UpdateNodeInput) -> Self {
        Self { label: input.label, parent_id: input.parent_id, contains: input.contains, body: input.body }
    }
}

impl From<crate::schema::CreateNodeInput> for Node {
    fn from(input: crate::schema::CreateNodeInput) -> Self {
        Self {
            id: input.id,
            label: input.label,
            parent_id: input.parent_id,
            contains: input.contains,
            body: input.body,
        }
    }
}

/// The fields `list_nodes` can order by. `name()` is the sort key the transports accept.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum NodeSortField {
    Id,
    Label,
}

impl ontogen_core::order::SortField for NodeSortField {
    const ALL: &'static [Self] = &[Self::Id, Self::Label];
    const ID: Self = Self::Id;

    fn name(self) -> &'static str {
        match self {
            Self::Id => "id",
            Self::Label => "label",
        }
    }
}

/// Orders `items` as `list_nodes` does on either backend: by each key of `order`, then by
/// id. A hand-written list that filters in memory sorts with this before it cuts a page.
pub fn sort_nodes(items: &mut [Node], order: &[OrderBy<NodeSortField>]) {
    let keys = ontogen_core::order::effective(order);
    items.sort_by(|a, b| {
        keys.iter()
            .map(|key| key.direction.apply(compare_nodes(a, b, key.field)))
            .find(|ord| ord.is_ne())
            .unwrap_or(::std::cmp::Ordering::Equal)
    });
}

/// One ascending key of [`sort_nodes`]: `None` first, floats with `-0.0` equal to `0.0`, enums
/// by the string they are stored as, which is what SQL compares.
fn compare_nodes(a: &Node, b: &Node, field: NodeSortField) -> ::std::cmp::Ordering {
    match field {
        NodeSortField::Id => a.id.cmp(&b.id),
        NodeSortField::Label => a.label.cmp(&b.label),
    }
}

impl Store {
    pub async fn list_nodes(
        &self,
        order: &[OrderBy<NodeSortField>],
        limit: Option<u64>,
        offset: Option<u64>,
    ) -> Result<Vec<Node>, AppError> {
        let mut query = order_nodes_query(node::Entity::find(), order);
        let limit = limit.map(|l| l.min(i64::MAX as u64));
        let offset = offset.map(|o| o.min(i64::MAX as u64));
        // sqlite-only: SQLite rejects OFFSET without LIMIT, so an offset alone takes i64::MAX rows.
        if let Some(l) = limit.or(offset.map(|_| i64::MAX as u64)) {
            query = query.limit(l);
        }
        if let Some(o) = offset {
            query = query.offset(o);
        }
        let models = query.all(self.db()).await.map_err(|e| AppError::DbError(e.to_string()))?;

        let mut records: Vec<Node> = models.iter().map(Node::from_model).collect::<Result<_, _>>()?;
        for record in &mut records {
            self.populate_node_relations(record).await?;
        }
        Ok(records)
    }

    pub async fn count_nodes(&self) -> Result<u64, AppError> {
        node::Entity::find().count(self.db()).await.map_err(|e| AppError::DbError(e.to_string()))
    }

    pub async fn get_node(&self, id: &str) -> Result<Node, AppError> {
        let model = node::Entity::find_by_id(id)
            .one(self.db())
            .await
            .map_err(|e| AppError::DbError(e.to_string()))?
            .ok_or_else(|| AppError::NodeNotFound(id.to_string()))?;

        let mut record = Node::from_model(&model)?;
        self.populate_node_relations(&mut record).await?;
        Ok(record)
    }

    pub async fn create_node(&self, mut record: Node) -> Result<Node, AppError> {
        hooks::before_create(self, &mut record).await?;

        if !record.id.trim().is_empty() && record.contains.contains(&record.id) {
            return Err(AppError::NodeParentCycle(record.id.clone()));
        }

        for child_id in &record.contains {
            if !self.node_exists(child_id).await? {
                return Err(AppError::NodeNotFound(child_id.clone()));
            }
        }

        let txn = self.db().begin().await.map_err(|e| AppError::DbError(e.to_string()))?;
        let id = if record.id.trim().is_empty() {
            let base = ontogen_core::id::slugify(&record.label);
            if base.is_empty() {
                return Err(AppError::NodeIdRequired("field \"label\" produced an empty slug".to_string()));
            }
            for candidate in ontogen_core::id::candidates(&base) {
                record.id = candidate;
                if self.try_insert_node(&txn, &record).await? {
                    break;
                }
            }
            record.id.clone()
        } else {
            ontogen_core::id::validate_id(&record.id).map_err(|e| AppError::DbError(e.to_string()))?;
            if !self.try_insert_node(&txn, &record).await? {
                return Err(AppError::NodeAlreadyExists(record.id));
            }
            record.id.clone()
        };

        for child_id in &record.contains {
            self.set_node_parent(&txn, child_id, Some(&id)).await?;
        }
        txn.commit().await.map_err(|e| AppError::DbError(e.to_string()))?;

        let created = self.get_node(&id).await?;
        self.emit_change(ChangeOp::Created, EntityKind::Node, id);

        hooks::after_create(self, &created).await?;
        Ok(created)
    }

    pub async fn update_node(&self, id: &str, updates: NodeUpdate) -> Result<Node, AppError> {
        let existing_model = node::Entity::find_by_id(id)
            .one(self.db())
            .await
            .map_err(|e| AppError::DbError(e.to_string()))?
            .ok_or_else(|| AppError::NodeNotFound(id.to_string()))?;

        let mut current = Node::from_model(&existing_model)?;
        self.populate_node_relations(&mut current).await?;

        hooks::before_update(self, &current, &updates).await?;

        let contains_changed = updates.contains.is_some();

        if updates.contains.as_ref().is_some_and(|ids| ids.iter().any(|c| c == id)) {
            return Err(AppError::NodeParentCycle(id.to_string()));
        }

        for child_id in updates.contains.iter().flatten() {
            if !self.node_exists(child_id).await? {
                return Err(AppError::NodeNotFound(child_id.clone()));
            }
        }

        let contains_dropped: Vec<String> = match &updates.contains {
            Some(new_ids) => current.contains.iter().filter(|c| !new_ids.contains(c)).cloned().collect(),
            None => Vec::new(),
        };

        updates.apply(&mut current);
        let active = current.to_active_model()?;

        let txn = self.db().begin().await.map_err(|e| AppError::DbError(e.to_string()))?;
        active.update(&txn).await.map_err(|e| AppError::DbError(e.to_string()))?;
        if contains_changed {
            for child_id in &current.contains {
                self.set_node_parent(&txn, child_id, Some(id)).await?;
            }
            for child_id in &contains_dropped {
                self.set_node_parent(&txn, child_id, None).await?;
            }
        }
        txn.commit().await.map_err(|e| AppError::DbError(e.to_string()))?;

        let result = self.get_node(id).await?;
        self.emit_change(ChangeOp::Updated, EntityKind::Node, id.to_string());

        hooks::after_update(self, &result).await?;
        Ok(result)
    }

    pub async fn delete_node(&self, id: &str) -> Result<(), AppError> {
        hooks::before_delete(self, id).await?;

        let existing = node::Entity::find_by_id(id)
            .one(self.db())
            .await
            .map_err(|e| AppError::DbError(e.to_string()))?
            .ok_or_else(|| AppError::NodeNotFound(id.to_string()))?;

        let active: node::ActiveModel = existing.into();
        active.delete(self.db()).await.map_err(|e| AppError::DbError(e.to_string()))?;

        self.emit_change(ChangeOp::Deleted, EntityKind::Node, id.to_string());

        hooks::after_delete(self, id).await?;
        Ok(())
    }

    pub(crate) async fn populate_node_relations(
        &self,
        record: &mut crate::schema::Node,
    ) -> Result<(), crate::schema::AppError> {
        record.contains = {
            use crate::persistence::db::entities::node;
            // sqlite-only: child ids sort in byte order under SQLite's default BINARY collation.
            let children = node::Entity::find()
                .filter(node::Column::ParentId.eq(&record.id))
                .filter(node::Column::Id.ne(&record.id))
                .order_by_asc(node::Column::Id)
                .all(self.db())
                .await
                .map_err(|e| crate::schema::AppError::DbError(e.to_string()))?;
            children.into_iter().map(|m| m.id).collect()
        };
        Ok(())
    }

    async fn try_insert_node<C: ::sea_orm::ConnectionTrait>(&self, conn: &C, record: &Node) -> Result<bool, AppError> {
        let active = record.to_active_model()?;
        match active.insert(conn).await {
            Ok(_) => Ok(true),
            Err(e) if matches!(e.sql_err(), Some(::sea_orm::SqlErr::UniqueConstraintViolation(_))) => {
                // sqlite-only: a failed INSERT leaves an SQLite transaction usable; Postgres aborts it.
                let taken = node::Entity::find_by_id(record.id.as_str())
                    .one(conn)
                    .await
                    .map_err(|e| AppError::DbError(e.to_string()))?
                    .is_some();
                if taken { Ok(false) } else { Err(AppError::DbError(e.to_string())) }
            }
            Err(e) => Err(AppError::DbError(e.to_string())),
        }
    }

    async fn set_node_parent<C: ::sea_orm::ConnectionTrait>(
        &self,
        conn: &C,
        child_id: &str,
        parent_id: Option<&str>,
    ) -> Result<(), AppError> {
        let update = ::sea_orm::sea_query::Query::update()
            .table(::sea_orm::sea_query::Alias::new("nodes"))
            .value(::sea_orm::sea_query::Alias::new("parent_id"), parent_id.map(str::to_string))
            .and_where(::sea_orm::sea_query::Expr::col(::sea_orm::sea_query::Alias::new("id")).eq(child_id))
            .to_owned();
        let stmt = conn.get_database_backend().build(&update);
        conn.execute(stmt).await.map_err(|e| AppError::DbError(e.to_string()))?;
        Ok(())
    }

    pub(crate) async fn node_exists(&self, id: &str) -> Result<bool, AppError> {
        Ok(node::Entity::find_by_id(id).one(self.db()).await.map_err(|e| AppError::DbError(e.to_string()))?.is_some())
    }
}

/// Applies `order` to `query` as `list_nodes` does: each key with nulls first ascending and last
/// descending, then the id. A hand-written list that filters in SQL orders through this.
pub fn order_nodes_query(
    mut query: ::sea_orm::Select<node::Entity>,
    order: &[OrderBy<NodeSortField>],
) -> ::sea_orm::Select<node::Entity> {
    for key in ontogen_core::order::effective(order) {
        let column = match key.field {
            NodeSortField::Id => node::Column::Id,
            NodeSortField::Label => node::Column::Label,
        };
        let (direction, nulls) = match key.direction {
            ontogen_core::order::Direction::Asc => {
                (::sea_orm::sea_query::Order::Asc, ::sea_orm::sea_query::NullOrdering::First)
            }
            ontogen_core::order::Direction::Desc => {
                (::sea_orm::sea_query::Order::Desc, ::sea_orm::sea_query::NullOrdering::Last)
            }
        };
        // sqlite-only: string keys sort in byte order under SQLite's default BINARY collation.
        query = query.order_by_with_nulls(column, direction, nulls);
    }
    query
}
