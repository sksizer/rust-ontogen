    let store = state.fitness_store().await.map_err(internal_error)?;
    let limit = pagination.limit.unwrap_or(20).min(100);
    let offset = pagination.offset.unwrap_or(0);
    let items =
        exercise::list(&store, Some(u64::from(limit)), Some(u64::from(offset))).await.map_err(internal_error)?;
    let total = exercise::count(&store).await.map_err(internal_error)?;
    Ok(Json(PaginatedResult { items, total, limit, offset }))
}

