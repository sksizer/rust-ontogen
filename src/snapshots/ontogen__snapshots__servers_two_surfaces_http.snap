async fn exercise_list(
    State(state): State<Arc<AppState>>,
    _: AcceptGuard,
    ontogen_query: Query<PageOpArgs>,
) -> Result<Response, ErrorObject> {
    let limit = ontogen_query.page_op_arg("limit")?.unwrap_or(20).min(100);
    let offset = ontogen_query.page_op_arg("offset")?.unwrap_or(0);
    let store = state.fitness_store().await.map_err(internal_error)?;
    let items =
        exercise::list(&store, Some(u64::from(limit)), Some(u64::from(offset))).await.map_err(internal_error)?;
    let total = exercise::count(&store).await.map_err(internal_error)?;
    let result = PaginatedResult { items, total, limit, offset };
    Ok(response::ok(&Document::meta_only(ResultMeta { result })))
}

