/// One message on an event feed of `Activity`.
#[derive(uniffi::Enum)]
pub enum ActivityFrame {
    /// An item, with its resume id when the feed is resumable.
    Event { id: Option<String>, data: Activity },
    /// The subscriber fell behind and `skipped` items were dropped.
    Lag { skipped: u64 },
}

impl From<ontogen_core::events::EventFrame<Activity>> for ActivityFrame {
    fn from(frame: ontogen_core::events::EventFrame<Activity>) -> Self {
        match frame {
            ontogen_core::events::EventFrame::Event { id, data } => ActivityFrame::Event { id, data },
            ontogen_core::events::EventFrame::Lag { skipped } => ActivityFrame::Lag { skipped },
        }
    }
}

