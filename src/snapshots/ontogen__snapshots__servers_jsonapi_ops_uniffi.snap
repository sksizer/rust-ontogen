/// A live `task_changed` feed. Call `next()` until it returns `None`.
#[derive(uniffi::Object)]
pub struct TaskChangedSubscription {
    rx: Arc<tokio::sync::Mutex<tokio::sync::broadcast::Receiver<Task>>>,
    id: ontogen_core::events::IdFn<Task>,
    runtime: tokio::runtime::Handle,
}

#[uniffi::export]
impl TaskChangedSubscription {
    /// The next frame: an event, or how many events were dropped because
    /// this subscriber fell behind. `None` once the feed closes.
    pub async fn next(&self) -> Option<TaskFrame> {
        let rx = self.rx.clone();
        let id = self.id;
        self.runtime
            .spawn(async move {
                let mut rx = rx.lock().await;
                ontogen_core::events::next_frame(&mut rx, id).await.map(TaskFrame::from)
            })
            .await
            .ok()
            .flatten()
    }
}

