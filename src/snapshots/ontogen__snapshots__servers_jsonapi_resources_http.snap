                Links::new(format!("{self_link}/relationships/epic")).with_related(format!("{self_link}/epic")),
                Linkage::ToOne(entity.epic_id.as_ref().map(|id| ResourceIdentifier::new("epics", id.as_str()))),
            ),
        )
        .with_relationship(
            "tags",
            Relationship::new(
                Links::new(format!("{self_link}/relationships/tags")).with_related(format!("{self_link}/tags")),
                Linkage::ToMany(entity.tags.iter().map(|id| ResourceIdentifier::new("tags", id.as_str())).collect()),
            ),
        )
}

