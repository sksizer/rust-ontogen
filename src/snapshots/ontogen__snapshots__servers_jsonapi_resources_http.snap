fn from_fields<T: serde::de::DeserializeOwned>(
    fields: serde_json::Map<String, serde_json::Value>,
) -> Result<T, ErrorObject> {
    serde_json::from_value(serde_json::Value::Object(fields)).map_err(internal_error)
}

