/// Partial update for a Article. Only `Some` values are applied.
#[derive(Debug, Clone, Default)]
pub struct ArticleUpdate {
    pub title: Option<String>,
    pub tags: Option<Vec<String>>,
    pub body: Option<String>,
}

impl ArticleUpdate {
    fn apply(&self, article: &mut Article) {
        if let Some(title) = &self.title {
            article.title.clone_from(title);
        }
        if let Some(tags) = &self.tags {
            article.tags.clone_from(tags);
        }
        if let Some(body) = &self.body {
            article.body.clone_from(body);
        }
    }
}

impl From<crate::schema::UpdateArticleInput> for ArticleUpdate {
    fn from(input: crate::schema::UpdateArticleInput) -> Self {
        Self { title: input.title, tags: input.tags, body: input.body }
    }
}

impl From<crate::schema::CreateArticleInput> for Article {
    fn from(input: crate::schema::CreateArticleInput) -> Self {
        Self { id: input.id, title: input.title, tags: input.tags, body: input.body }
    }
}

/// The fields `list_articles` can order by. `name()` is the sort key the transports accept.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum ArticleSortField {
    Id,
    Title,
}

impl ontogen_core::order::SortField for ArticleSortField {
    const ALL: &'static [Self] = &[Self::Id, Self::Title];
    const ID: Self = Self::Id;

    fn name(self) -> &'static str {
        match self {
            Self::Id => "id",
            Self::Title => "title",
        }
    }
}

/// Orders `items` as `list_articles` does on either backend: by each key of `order`, then by
/// id. A hand-written list that filters in memory sorts with this before it cuts a page.
pub fn sort_articles(items: &mut [Article], order: &[OrderBy<ArticleSortField>]) {
    let keys = ontogen_core::order::effective(order);
    items.sort_by(|a, b| {
        keys.iter()
            .map(|key| key.direction.apply(compare_articles(a, b, key.field)))
            .find(|ord| ord.is_ne())
            .unwrap_or(std::cmp::Ordering::Equal)
    });
}

/// One ascending key of [`sort_articles`]: `None` first, floats with `-0.0` equal to `0.0`, enums
/// by the string they are stored as, which is what SQL compares.
fn compare_articles(a: &Article, b: &Article, field: ArticleSortField) -> std::cmp::Ordering {
    match field {
        ArticleSortField::Id => a.id.cmp(&b.id),
        ArticleSortField::Title => a.title.cmp(&b.title),
    }
}

impl Store {
    pub async fn list_articles(
        &self,
        order: &[OrderBy<ArticleSortField>],
        limit: Option<u64>,
        offset: Option<u64>,
    ) -> Result<Vec<Article>, AppError> {
        let mut query = order_articles_query(article::Entity::find(), order);
        let limit = limit.map(|l| l.min(i64::MAX as u64));
        let offset = offset.map(|o| o.min(i64::MAX as u64));
        // sqlite-only: SQLite rejects OFFSET without LIMIT, so an offset alone takes i64::MAX rows.
        if let Some(l) = limit.or(offset.map(|_| i64::MAX as u64)) {
            query = query.limit(l);
        }
        if let Some(o) = offset {
            query = query.offset(o);
        }
        let models = query.all(self.db()).await.map_err(|e| AppError::DbError(e.to_string()))?;

        let mut entities: Vec<Article> = models.iter().map(Article::from_model).collect::<Result<_, _>>()?;
        for entity in &mut entities {
            self.populate_article_relations(entity).await?;
        }
        Ok(entities)
    }

    pub async fn count_articles(&self) -> Result<u64, AppError> {
        article::Entity::find().count(self.db()).await.map_err(|e| AppError::DbError(e.to_string()))
    }

    pub async fn get_article(&self, id: &str) -> Result<Article, AppError> {
        let model = article::Entity::find_by_id(id)
            .one(self.db())
            .await
            .map_err(|e| AppError::DbError(e.to_string()))?
            .ok_or_else(|| AppError::ArticleNotFound(id.to_string()))?;

        let mut entity = Article::from_model(&model)?;
        self.populate_article_relations(&mut entity).await?;
        Ok(entity)
    }

    pub async fn create_article(&self, mut article: Article) -> Result<Article, AppError> {
        hooks::before_create(self, &mut article).await?;

        let tags = article.tags.clone();

        let txn = self.db().begin().await.map_err(|e| AppError::DbError(e.to_string()))?;
        let id = if article.id.trim().is_empty() {
            return Err(AppError::ArticleIdRequired("this store requires the caller to supply an id".to_string()));
        } else {
            ontogen_core::id::validate_id(&article.id).map_err(|e| AppError::DbError(e.to_string()))?;
            if !self.try_insert_article(&txn, &article).await? {
                return Err(AppError::ArticleAlreadyExists(article.id));
            }
            article.id.clone()
        };

        self.sync_junction(&txn, "article_tags", "article_id", "tag_id", &id, &tags).await?;
        txn.commit().await.map_err(|e| AppError::DbError(e.to_string()))?;

        let created = self.get_article(&id).await?;
        self.emit_change(ChangeOp::Created, EntityKind::Article, id);

        hooks::after_create(self, &created).await?;
        Ok(created)
    }

    pub async fn update_article(&self, id: &str, updates: ArticleUpdate) -> Result<Article, AppError> {
        let existing_model = article::Entity::find_by_id(id)
            .one(self.db())
            .await
            .map_err(|e| AppError::DbError(e.to_string()))?
            .ok_or_else(|| AppError::ArticleNotFound(id.to_string()))?;

        let mut current = Article::from_model(&existing_model)?;
        self.populate_article_relations(&mut current).await?;

        hooks::before_update(self, &current, &updates).await?;

        let tags_changed = updates.tags.is_some();

        updates.apply(&mut current);
        let active = current.to_active_model()?;

        let txn = self.db().begin().await.map_err(|e| AppError::DbError(e.to_string()))?;
        active.update(&txn).await.map_err(|e| AppError::DbError(e.to_string()))?;
        if tags_changed {
            self.sync_junction(&txn, "article_tags", "article_id", "tag_id", id, &current.tags).await?;
        }
        txn.commit().await.map_err(|e| AppError::DbError(e.to_string()))?;

        let result = self.get_article(id).await?;
        self.emit_change(ChangeOp::Updated, EntityKind::Article, id.to_string());

        hooks::after_update(self, &result).await?;
        Ok(result)
    }

    pub async fn delete_article(&self, id: &str) -> Result<(), AppError> {
        hooks::before_delete(self, id).await?;

        let existing = article::Entity::find_by_id(id)
            .one(self.db())
            .await
            .map_err(|e| AppError::DbError(e.to_string()))?
            .ok_or_else(|| AppError::ArticleNotFound(id.to_string()))?;

        let active: article::ActiveModel = existing.into();
        active.delete(self.db()).await.map_err(|e| AppError::DbError(e.to_string()))?;

        self.emit_change(ChangeOp::Deleted, EntityKind::Article, id.to_string());

        hooks::after_delete(self, id).await?;
        Ok(())
    }

    pub(crate) async fn populate_article_relations(
        &self,
        article: &mut crate::schema::Article,
    ) -> Result<(), crate::schema::AppError> {
        article.tags = self.load_junction_ids("article_tags", "article_id", "tag_id", &article.id).await?;
        Ok(())
    }

    async fn try_insert_article<C: sea_orm::ConnectionTrait>(
        &self,
        conn: &C,
        article: &Article,
    ) -> Result<bool, AppError> {
        let active = article.to_active_model()?;
        match active.insert(conn).await {
            Ok(_) => Ok(true),
            Err(e) if matches!(e.sql_err(), Some(sea_orm::SqlErr::UniqueConstraintViolation(_))) => {
                // sqlite-only: a failed INSERT leaves an SQLite transaction usable; Postgres aborts it.
                let taken = article::Entity::find_by_id(article.id.as_str())
                    .one(conn)
                    .await
                    .map_err(|e| AppError::DbError(e.to_string()))?
                    .is_some();
                if taken { Ok(false) } else { Err(AppError::DbError(e.to_string())) }
            }
            Err(e) => Err(AppError::DbError(e.to_string())),
        }
    }
}

/// Applies `order` to `query` as `list_articles` does: each key with nulls first ascending and last
/// descending, then the id. A hand-written list that filters in SQL orders through this.
pub fn order_articles_query(
    mut query: Select<article::Entity>,
    order: &[OrderBy<ArticleSortField>],
) -> Select<article::Entity> {
    for key in ontogen_core::order::effective(order) {
        let column = match key.field {
            ArticleSortField::Id => article::Column::Id,
            ArticleSortField::Title => article::Column::Title,
        };
        let (direction, nulls) = match key.direction {
            ontogen_core::order::Direction::Asc => (Order::Asc, NullOrdering::First),
            ontogen_core::order::Direction::Desc => (Order::Desc, NullOrdering::Last),
        };
        // sqlite-only: string keys sort in byte order under SQLite's default BINARY collation.
        query = query.order_by_with_nulls(column, direction, nulls);
    }
    query
}
