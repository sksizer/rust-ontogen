/// The fields `list_articles` can order by. `name()` is the sort key the transports accept.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum ArticleSortField {
    Id,
    Title,
}

impl ontogen_core::order::SortField for ArticleSortField {
    const ALL: &'static [Self] = &[Self::Id, Self::Title];
    const ID: Self = Self::Id;

    fn name(self) -> &'static str {
        match self {
            Self::Id => "id",
            Self::Title => "title",
        }
