            .one(self.db())
            .await
            .map_err(|e| AppError::DbError(e.to_string()))?
            .ok_or_else(|| AppError::ArticleNotFound(id.to_string()))?;

        let active: article::ActiveModel = existing.into();
        active.delete(self.db()).await.map_err(|e| AppError::DbError(e.to_string()))?;

