    pub async fn create_article(&self, mut record: Article) -> Result<Article, AppError> {
        hooks::before_create(self, &mut record).await?;

        let id = if record.id.trim().is_empty() {
            return Err(AppError::ArticleIdRequired("this store requires the caller to supply an id".to_string()));
