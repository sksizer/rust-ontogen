/// `entity` as a resource object of type `tasks`, its `links.self`
/// under `collection`.
fn ontogen_task_as_resource<'a>(
    entity: &'a Task,
    collection: &str,
) -> OntogenResourceObject<OntogenTaskResourceAttributes<'a>> {
    let self_link = format!("{collection}/{}", ::ontogen_jsonapi::links::encode_path_segment(&entity.id));
    OntogenResourceObject::new("tasks", entity.id.clone(), OntogenTaskResourceAttributes(entity), self_link.clone())
        .with_relationship(
            "epic",
            OntogenRelationship::new(
                OntogenLinks::new(format!("{self_link}/relationships/epic")).with_related(format!("{self_link}/epic")),
                OntogenLinkage::ToOne(
                    entity.epic_id.as_ref().map(|id| OntogenResourceIdentifier::new("epics", id.as_str())),
                ),
            ),
        )
        .with_relationship(
            "tags",
            OntogenRelationship::new(
                OntogenLinks::new(format!("{self_link}/relationships/tags")).with_related(format!("{self_link}/tags")),
                OntogenLinkage::ToMany(
                    entity.tags.iter().map(|id| OntogenResourceIdentifier::new("tags", id.as_str())).collect(),
                ),
            ),
        )
        .with_relationship(
            "labels",
            OntogenRelationship::from_links(
                OntogenLinks::new(format!("{self_link}/relationships/labels"))
                    .with_related(format!("{self_link}/labels")),
            ),
        )
}

