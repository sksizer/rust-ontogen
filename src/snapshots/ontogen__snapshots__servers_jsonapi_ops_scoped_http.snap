/// An `AppError` as an error object: the status its variant's name gives,
/// and the name in snake_case as the code.
fn ontogen_app_error(e: crate::schema::AppError) -> OntogenErrorObject {
    let (status, code) = match &e {
        crate::schema::AppError::TaskNotFound(..) => (OntogenStatusCode::NOT_FOUND, "task_not_found"),
        crate::schema::AppError::TaskIdRequired(..) => (OntogenStatusCode::BAD_REQUEST, "task_id_required"),
        crate::schema::AppError::TaskAlreadyExists(..) => (OntogenStatusCode::CONFLICT, "task_already_exists"),
        crate::schema::AppError::EpicNotFound(..) => (OntogenStatusCode::NOT_FOUND, "epic_not_found"),
        crate::schema::AppError::TagNotFound(..) => (OntogenStatusCode::NOT_FOUND, "tag_not_found"),
        crate::schema::AppError::DbError(..) => (OntogenStatusCode::INTERNAL_SERVER_ERROR, "db_error"),
    };
    OntogenErrorObject::app(status, code, e.to_string())
}

/// A failure no `AppError` describes: opening the store, a scope accessor,
/// or an op with another error type.
fn ontogen_internal_error(e: impl ::std::fmt::Display) -> OntogenErrorObject {
    OntogenErrorObject::internal(e.to_string())
}

/// The method fallback of a route serving `allowed`: `405` with `Allow`.
fn ontogen_allow<const N: usize>(
    allowed: [OntogenMethod; N],
) -> impl Fn(OntogenMethod) -> ::std::future::Ready<OntogenResponse> + Clone + Send + Sync + 'static {
    move |method| ::std::future::ready(::ontogen_jsonapi::error::method_not_allowed(&method, &allowed))
}

/// The error document for a rejection of Axum's own `Query`. An event
/// stream is no JSON:API route, so it reads its plain query parameters with
/// it.
fn ontogen_query_rejection(e: OntogenQueryRejection) -> OntogenErrorObject {
    OntogenErrorObject::new(OntogenErrorCode::InvalidQueryParameter, e.body_text())
}

