/// be checked to name resources that exist.
#[derive(Default)]
struct OntogenTaskLinkedIds {
    epic_id: Option<OntogenLinkedId>,
    tags: Vec<OntogenLinkedId>,
}

/// The fields a create or update document for `tasks` sets, named as
/// the input's fields, each member checked against the schema.
fn ontogen_task_request_fields(
    data: &OntogenResourceData,
    create: bool,
) -> Result<(::serde_json::Map<String, ::serde_json::Value>, OntogenTaskLinkedIds), OntogenErrorObject> {
    let attributes = data.attributes.as_ref();
