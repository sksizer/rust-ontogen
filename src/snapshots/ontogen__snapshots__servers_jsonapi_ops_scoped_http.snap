async fn task_changed_sse_scoped(
    OntogenState(ontogen_state): OntogenState<::std::sync::Arc<AppState>>,
    OntogenPath(ontogen_scope): OntogenPath<::uuid::Uuid>,
) -> OntogenSse<impl ::futures::Stream<Item = Result<OntogenEvent, ::std::convert::Infallible>>> {
    let ontogen_rx = ontogen_state.subscribe_task_changed_for(&ontogen_scope);
    ontogen_sse_stream("task-changed", ontogen_rx, ::ontogen_core::events::no_id, ontogen_task_frame_data)
}

async fn activity_for_kind_sse_scoped(
    OntogenState(ontogen_state): OntogenState<::std::sync::Arc<AppState>>,
    OntogenPath((ontogen_scope, kind)): OntogenPath<(::uuid::Uuid, String)>,
    ontogen_query: Result<::axum::extract::Query<OntogenActivityActivityForKindEventQuery>, OntogenQueryRejection>,
    ontogen_headers: ::axum::http::HeaderMap,
) -> Result<
    OntogenSse<impl ::futures::Stream<Item = Result<OntogenEvent, ::std::convert::Infallible>>>,
    OntogenErrorObject,
> {
    let ::axum::extract::Query(ontogen_query) = ontogen_query.map_err(ontogen_query_rejection)?;
    let ontogen_resume =
        ::ontogen_core::events::last_event_id(ontogen_headers.get("last-event-id").map(|v| v.as_bytes()))
            .or(ontogen_query.resume);
    let ontogen_rx = ontogen_state
        .subscribe_activity_for_kind_for(&ontogen_scope, kind, ontogen_resume)
        .await
        .map_err(ontogen_app_error)?;
    Ok(ontogen_sse_stream("activity-for-kind", ontogen_rx, ::ontogen_core::events::seq_id, ontogen_result_frame))
}

async fn log_lines_sse_scoped(
    OntogenState(ontogen_state): OntogenState<::std::sync::Arc<AppState>>,
    OntogenPath(ontogen_scope): OntogenPath<::uuid::Uuid>,
    ontogen_query: Result<::axum::extract::Query<OntogenActivityLogLinesEventQuery>, OntogenQueryRejection>,
) -> Result<
    OntogenSse<impl ::futures::Stream<Item = Result<OntogenEvent, ::std::convert::Infallible>>>,
    OntogenErrorObject,
> {
    let ::axum::extract::Query(ontogen_query) = ontogen_query.map_err(ontogen_query_rejection)?;
    let ontogen_rx =
        ontogen_state.subscribe_log_lines_for(&ontogen_scope, ontogen_query.level).map_err(ontogen_internal_error)?;
    Ok(ontogen_sse_stream("log-lines", ontogen_rx, ::ontogen_core::events::no_id, ontogen_result_frame))
}

/// Generated routes. Call this from your main router.
pub fn entity_routes() -> ::axum::Router<::std::sync::Arc<AppState>> {
    ::axum::Router::new()
        .route(
            "/api/workouts/version",
            ::axum::routing::get(workout_get_version).fallback(ontogen_allow([OntogenMethod::GET])),
        )
        .route(
            "/api/events/task-changed",
            ::axum::routing::get(task_changed_sse).fallback(ontogen_allow([OntogenMethod::GET])),
        )
        .route(
            "/api/events/activity-for-kind/{kind}",
            ::axum::routing::get(activity_for_kind_sse).fallback(ontogen_allow([OntogenMethod::GET])),
        )
        .route(
            "/api/events/log-lines",
            ::axum::routing::get(log_lines_sse).fallback(ontogen_allow([OntogenMethod::GET])),
        )
        .route(
            "/api/projects/{project_id}/agents",
            ::axum::routing::get(agent_list_scoped).fallback(ontogen_allow([OntogenMethod::GET])),
        )
        .route(
            "/api/projects/{project_id}/epics",
            ::axum::routing::get(epic_list_scoped)
                .post(epic_create_scoped)
                .fallback(ontogen_allow([OntogenMethod::GET, OntogenMethod::POST])),
        )
        .route(
            "/api/projects/{project_id}/epics/{id}",
            ::axum::routing::get(epic_get_by_id_scoped)
                .patch(epic_update_scoped)
                .delete(epic_delete_scoped)
                .fallback(ontogen_allow([OntogenMethod::GET, OntogenMethod::PATCH, OntogenMethod::DELETE])),
        )
        .route(
            "/api/projects/{project_id}/reports",
            ::axum::routing::get(report_list_scoped)
                .post(report_create_scoped)
                .fallback(ontogen_allow([OntogenMethod::GET, OntogenMethod::POST])),
        )
        .route(
            "/api/projects/{project_id}/reports/{id}",
            ::axum::routing::get(report_get_by_id_scoped)
                .patch(report_update_scoped)
                .delete(report_delete_scoped)
                .fallback(ontogen_allow([OntogenMethod::GET, OntogenMethod::PATCH, OntogenMethod::DELETE])),
        )
        .route(
            "/api/projects/{project_id}/tags",
            ::axum::routing::get(tag_list_scoped)
                .post(tag_create_scoped)
                .fallback(ontogen_allow([OntogenMethod::GET, OntogenMethod::POST])),
        )
        .route(
            "/api/projects/{project_id}/tags/{id}",
            ::axum::routing::get(tag_get_by_id_scoped)
                .patch(tag_update_scoped)
                .delete(tag_delete_scoped)
                .fallback(ontogen_allow([OntogenMethod::GET, OntogenMethod::PATCH, OntogenMethod::DELETE])),
        )
        .route(
            "/api/projects/{project_id}/tasks",
            ::axum::routing::get(task_list_scoped)
                .post(task_create_scoped)
                .fallback(ontogen_allow([OntogenMethod::GET, OntogenMethod::POST])),
        )
        .route(
            "/api/projects/{project_id}/tasks/{id}",
            ::axum::routing::get(task_get_by_id_scoped)
                .patch(task_update_scoped)
                .delete(task_delete_scoped)
                .fallback(ontogen_allow([OntogenMethod::GET, OntogenMethod::PATCH, OntogenMethod::DELETE])),
        )
        .route(
            "/api/projects/{project_id}/tasks/list-overdue/{before}",
            ::axum::routing::get(task_list_overdue_scoped).fallback(ontogen_allow([OntogenMethod::GET])),
        )
        .route(
            "/api/projects/{project_id}/tasks/{id}/relationships/{rel}",
            ::axum::routing::get(ontogen_task_relationship_get_scoped)
                .patch(ontogen_task_relationship_patch_scoped)
                .post(ontogen_task_relationship_post_scoped)
                .delete(ontogen_task_relationship_delete_scoped)
                .fallback(ontogen_allow([
                    OntogenMethod::GET,
                    OntogenMethod::PATCH,
                    OntogenMethod::POST,
                    OntogenMethod::DELETE,
                ])),
        )
        .route(
            "/api/projects/{project_id}/tasks/{id}/{rel}",
            ::axum::routing::get(ontogen_task_related_get_scoped).fallback(ontogen_allow([OntogenMethod::GET])),
        )
        .route(
            "/api/projects/{project_id}/workouts/summary/{id}",
            ::axum::routing::get(workout_get_summary_scoped).fallback(ontogen_allow([OntogenMethod::GET])),
        )
        .route(
            "/api/projects/{project_id}/workouts/start",
            ::axum::routing::post(workout_start_scoped).fallback(ontogen_allow([OntogenMethod::POST])),
        )
        .route(
            "/api/projects/{project_id}/workouts/rename",
            ::axum::routing::post(workout_rename_scoped).fallback(ontogen_allow([OntogenMethod::POST])),
        )
        .route(
            "/api/projects/{project_id}/workouts/pause",
            ::axum::routing::post(workout_pause_scoped).fallback(ontogen_allow([OntogenMethod::POST])),
        )
        .route(
            "/api/projects/{project_id}/workouts/{parent_id}/labels",
            ::axum::routing::get(workout_list_labels_scoped)
                .post(workout_add_label_scoped)
                .fallback(ontogen_allow([OntogenMethod::GET, OntogenMethod::POST])),
        )
        .route(
            "/api/projects/{project_id}/workouts/{parent_id}/labels/{child_id}",
            ::axum::routing::delete(workout_remove_label_scoped).fallback(ontogen_allow([OntogenMethod::DELETE])),
        )
        .route(
            "/api/projects/{project_id}/events/task-changed",
            ::axum::routing::get(task_changed_sse_scoped).fallback(ontogen_allow([OntogenMethod::GET])),
        )
        .route(
            "/api/projects/{project_id}/events/activity-for-kind/{kind}",
            ::axum::routing::get(activity_for_kind_sse_scoped).fallback(ontogen_allow([OntogenMethod::GET])),
        )
        .route(
            "/api/projects/{project_id}/events/log-lines",
            ::axum::routing::get(log_lines_sse_scoped).fallback(ontogen_allow([OntogenMethod::GET])),
        )
}
