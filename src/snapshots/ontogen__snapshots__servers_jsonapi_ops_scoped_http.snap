) -> Result<OntogenResponse, OntogenErrorObject> {
    let ontogen_store = ontogen_state.store_for(&ontogen_scope).map_err(ontogen_internal_error)?;
    tag::delete(&ontogen_store, ontogen_tag_lookup_key(&id)?).await.map_err(ontogen_app_error)?;
    Ok(::ontogen_jsonapi::response::no_content())
}

async fn task_list_scoped(
    OntogenState(ontogen_state): OntogenState<::std::sync::Arc<AppState>>,
    _: OntogenAcceptGuard,
    OntogenPath(ontogen_scope): OntogenPath<::uuid::Uuid>,
    query: OntogenQuery<OntogenPagedListParams>,
) -> Result<OntogenResponse, OntogenErrorObject> {
    let order = query.sort_order("tasks")?;
    let include = query.include_paths("tasks", &["epic", "tags"], &["labels"])?;
    let (offset, limit) = ontogen_page(&query, 20, 100)?;
    let link_query = query.link_query(include.as_deref())?;
    let ontogen_store = ontogen_state.store_for(&ontogen_scope).map_err(ontogen_internal_error)?;
    let items = task::list(&ontogen_store, &order, Some(u64::from(limit)), Some(u64::from(offset)))
        .await
        .map_err(ontogen_app_error)?;
    let total = task::count(&ontogen_store).await.map_err(ontogen_app_error)?;
    let collection =
        &format!("/api/projects/{}/tasks", ::ontogen_jsonapi::links::encode_path_segment(&ontogen_scope.to_string()));
    let data: Vec<_> = items.iter().map(|entity| ontogen_task_as_resource(entity, collection)).collect();
    let links = ::ontogen_jsonapi::links::pagination_links(collection, &link_query, offset, limit, total);
    let mut document = OntogenDocument::new(data, links).with_meta(OntogenPageMeta { total, limit, offset });
    if let Some(paths) = &include {
        document =
            document.with_included(ontogen_task_included_scoped(&ontogen_state, &ontogen_scope, &items, paths).await?);
    }
    Ok(::ontogen_jsonapi::response::ok(&document))
}

async fn task_get_by_id_scoped(
    OntogenState(ontogen_state): OntogenState<::std::sync::Arc<AppState>>,
    _: OntogenAcceptGuard,
    OntogenPath((ontogen_scope, id)): OntogenPath<(::uuid::Uuid, OntogenLookupKey)>,
    query: OntogenQuery<OntogenGetParams>,
) -> Result<OntogenResponse, OntogenErrorObject> {
    let include = query.include_paths("tasks", &["epic", "tags"], &["labels"])?;
    let link_query = query.link_query(include.as_deref())?;
    let ontogen_store = ontogen_state.store_for(&ontogen_scope).map_err(ontogen_internal_error)?;
    let entity = task::get_by_id(&ontogen_store, ontogen_task_lookup_key(&id)?).await.map_err(ontogen_app_error)?;
    let collection =
        &format!("/api/projects/{}/tasks", ::ontogen_jsonapi::links::encode_path_segment(&ontogen_scope.to_string()));
    let mut document = OntogenDocument::resource(ontogen_task_as_resource(&entity, collection), &link_query);
    if let Some(paths) = &include {
        document = document.with_included(
            ontogen_task_included_scoped(&ontogen_state, &ontogen_scope, ::std::slice::from_ref(&entity), paths)
                .await?,
        );
    }
    Ok(::ontogen_jsonapi::response::ok(&document))
}

async fn task_create_scoped(
    OntogenState(ontogen_state): OntogenState<::std::sync::Arc<AppState>>,
    _: OntogenAcceptGuard,
    path_params: Result<OntogenPath<::uuid::Uuid>, OntogenErrorObject>,
    query: Result<OntogenQuery<OntogenNoParams>, OntogenErrorObject>,
    body: OntogenBody,
) -> Result<OntogenResponse, OntogenErrorObject> {
    let OntogenPath(ontogen_scope) = path_params?;
    query?;
    let body = body.into_bytes()?;
    let collection =
        &format!("/api/projects/{}/tasks", ::ontogen_jsonapi::links::encode_path_segment(&ontogen_scope.to_string()));
    let endpoint = OntogenEndpoint { type_name: "tasks", path: collection };
    let data = ::ontogen_jsonapi::request::parse_create(&body, endpoint, |id| {
        ::ontogen_core::id::validate_id(id).map_err(|e| e.reason)
    })?;
    let (fields, linked) = ontogen_task_request_fields(&data, true)?;
    let input: CreateTaskInput = ontogen_from_fields(fields)?;
    let ontogen_store = ontogen_state.store_for(&ontogen_scope).map_err(ontogen_internal_error)?;
    ontogen_task_check_linked_scoped(&ontogen_state, &ontogen_scope, &linked).await?;
    let entity = task::create(&ontogen_store, input).await.map_err(|e| match e {
        e @ crate::schema::AppError::TaskAlreadyExists(..) if data.id.is_some() => {
            ontogen_app_error(e).with_pointer("/data/id")
        }
        e => ontogen_app_error(e),
    })?;
    let document =
        OntogenDocument::resource(ontogen_task_as_resource(&entity, collection), &OntogenCanonicalQuery::new());
    let location = document.data().and_then(OntogenResourceObject::links).map(OntogenLinks::self_link);
    Ok(::ontogen_jsonapi::response::created(location, &document))
}

async fn task_update_scoped(
    OntogenState(ontogen_state): OntogenState<::std::sync::Arc<AppState>>,
    _: OntogenAcceptGuard,
    path_params: Result<OntogenPath<(::uuid::Uuid, OntogenLookupKey)>, OntogenErrorObject>,
    query: Result<OntogenQuery<OntogenNoParams>, OntogenErrorObject>,
    body: OntogenBody,
) -> Result<OntogenResponse, OntogenErrorObject> {
    let OntogenPath((ontogen_scope, id)) = path_params?;
    query?;
    let body = body.into_bytes()?;
    let collection =
        &format!("/api/projects/{}/tasks", ::ontogen_jsonapi::links::encode_path_segment(&ontogen_scope.to_string()));
    let path = format!("{collection}/{id}");
    let endpoint = OntogenEndpoint { type_name: "tasks", path: &path };
    let data = ::ontogen_jsonapi::request::parse_update(&body, endpoint, &id)?;
    let (fields, linked) = ontogen_task_request_fields(&data, false)?;
    let input: UpdateTaskInput = ontogen_from_fields(fields)?;
    let ontogen_store = ontogen_state.store_for(&ontogen_scope).map_err(ontogen_internal_error)?;
    ontogen_task_check_linked_scoped(&ontogen_state, &ontogen_scope, &linked).await?;
    let entity = task::update(&ontogen_store, ontogen_task_lookup_key(&id)?, input).await.map_err(ontogen_app_error)?;
    Ok(::ontogen_jsonapi::response::ok(&OntogenDocument::resource(
        ontogen_task_as_resource(&entity, collection),
        &OntogenCanonicalQuery::new(),
    )))
}

async fn task_delete_scoped(
    OntogenState(ontogen_state): OntogenState<::std::sync::Arc<AppState>>,
    _: OntogenAcceptGuard,
    OntogenPath((ontogen_scope, id)): OntogenPath<(::uuid::Uuid, OntogenLookupKey)>,
