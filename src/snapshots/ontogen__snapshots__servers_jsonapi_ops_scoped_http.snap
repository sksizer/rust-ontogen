        &mut fields,
        "title",
        ::ontogen_jsonapi::request::attribute::<String>(attributes, "title", create)?,
    );
    ontogen_set_field(
        &mut fields,
        "notes",
        ::ontogen_jsonapi::request::attribute::<Option<String>>(attributes, "notes", false)?,
    );
    ontogen_set_field(&mut fields, "done", ::ontogen_jsonapi::request::attribute::<bool>(attributes, "done", false)?);
    ontogen_set_field(
        &mut fields,
        "body",
        ::ontogen_jsonapi::request::attribute::<String>(attributes, "body", create)?,
    );
    let relationships = data.relationships()?;
    ::ontogen_jsonapi::request::check_relationship_names(relationships, "tasks", &["epic", "tags", "labels"])?;
    let mut linked = OntogenTaskLinkedIds::default();
    if let Some(rel) = relationships.and_then(|r| r.get("epic")) {
        let id = ::ontogen_jsonapi::request::to_one(rel, "/data/relationships/epic", "epics", true)?;
        fields.insert("epic_id".to_owned(), id.clone().map_or(::serde_json::Value::Null, ::serde_json::Value::String));
        linked.epic_id = id.map(|id| OntogenLinkedId { id, pointer: "/data/relationships/epic/data".to_owned() });
    }
    if let Some(rel) = relationships.and_then(|r| r.get("tags")) {
        let ids = ::ontogen_jsonapi::request::to_many_linked(rel, "/data/relationships/tags", "tags", None)?;
        fields.insert("tags".to_owned(), ids.iter().map(|l| ::serde_json::Value::String(l.id.clone())).collect());
        linked.tags = ids;
    }
    if relationships.is_some_and(|r| r.contains_key("labels")) {
        return Err(::ontogen_jsonapi::error::relationship_update_unsupported("tasks", "labels", "a create or update")
            .with_pointer("/data/relationships/labels"));
    }
    Ok((fields, linked))
}

/// Checks that each id a create or update document for `tasks` links
/// names a resource that exists, in the order the document was read.
async fn ontogen_task_check_linked_scoped(
    state: &AppState,
    ontogen_scope: &::uuid::Uuid,
    linked: &OntogenTaskLinkedIds,
) -> Result<(), OntogenErrorObject> {
    let store = state.store_for(ontogen_scope).map_err(ontogen_internal_error)?;
    if let Some(linked) = &linked.epic_id {
        match epic::get_by_id(&store, &linked.id).await {
            Ok(_) => {}
            Err(crate::schema::AppError::EpicNotFound(..)) => return Err(linked.not_found("epics")),
            Err(e) => return Err(ontogen_app_error(e)),
        }
    }
    for linked in &linked.tags {
        match tag::get_by_id(&store, &linked.id).await {
            Ok(_) => {}
            Err(crate::schema::AppError::TagNotFound(..)) => return Err(linked.not_found("tags")),
            Err(e) => return Err(ontogen_app_error(e)),
        }
    }
    Ok(())
}

/// A `Task` event item as its resource object. A frame is not tied to a
/// request URL, so it carries no links.
fn ontogen_task_frame_data(event: OntogenEvent, entity: &Task) -> Result<OntogenEvent, ::axum::Error> {
    event.json_data(ontogen_task_as_resource(entity, "/api/tasks").into_unlinked())
}

/// The `tasks` resource `id` names, read as its `GET` reads it: the
/// parent of a relationship route.
async fn ontogen_task_read_scoped(
    state: &AppState,
    ontogen_scope: &::uuid::Uuid,
    id: &OntogenLookupKey,
) -> Result<Task, OntogenErrorObject> {
    let store = state.store_for(ontogen_scope).map_err(ontogen_internal_error)?;
    task::get_by_id(&store, ontogen_task_lookup_key(id)?).await.map_err(ontogen_app_error)
}

/// Sets the relation field `field` of the `tasks` resource `id` to
/// `value` through `task::update`, as a resource `PATCH` naming only that
/// relationship does.
async fn ontogen_task_write_field_scoped(
    state: &AppState,
    ontogen_scope: &::uuid::Uuid,
    id: &str,
    field: &str,
    value: ::serde_json::Value,
) -> Result<(), OntogenErrorObject> {
    let input: UpdateTaskInput = ontogen_from_fields(::serde_json::Map::from_iter([(field.to_owned(), value)]))?;
    let store = state.store_for(ontogen_scope).map_err(ontogen_internal_error)?;
    task::update(&store, id, input).await.map_err(ontogen_app_error)?;
    Ok(())
}

/// The `epics` resources `ids` name, in order, without the ids that
/// name none.
async fn ontogen_epic_fetch_scoped(
    state: &AppState,
    ontogen_scope: &::uuid::Uuid,
    ids: &[String],
) -> Result<Vec<Epic>, OntogenErrorObject> {
    let store = state.store_for(ontogen_scope).map_err(ontogen_internal_error)?;
    let mut found = Vec::with_capacity(ids.len());
    for id in ids {
        match epic::get_by_id(&store, id).await {
            Ok(entity) => found.push(entity),
            Err(crate::schema::AppError::EpicNotFound(..)) => {}
            Err(e) => return Err(ontogen_app_error(e)),
        }
    }
    Ok(found)
}

