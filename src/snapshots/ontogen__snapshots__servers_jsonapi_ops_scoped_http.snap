async fn task_changed_sse_scoped(
    State(ontogen_state): State<Arc<AppState>>,
    Path(ontogen_scope): Path<uuid::Uuid>,
) -> Sse<impl futures::Stream<Item = Result<Event, Infallible>>> {
    let ontogen_rx = ontogen_state.subscribe_task_changed_for(&ontogen_scope);
    ontogen_sse_stream("task-changed", ontogen_rx, ontogen_core::events::no_id, ontogen_task_frame_data)
}

async fn activity_for_kind_sse_scoped(
    State(ontogen_state): State<Arc<AppState>>,
    Path((ontogen_scope, kind)): Path<(uuid::Uuid, String)>,
    ontogen_query: Result<axum::extract::Query<ActivityActivityForKindEventQuery>, QueryRejection>,
    ontogen_headers: axum::http::HeaderMap,
) -> Result<Sse<impl futures::Stream<Item = Result<Event, Infallible>>>, ErrorObject> {
    let axum::extract::Query(ontogen_query) = ontogen_query.map_err(ontogen_query_rejection)?;
    let ontogen_resume =
        ontogen_core::events::last_event_id(ontogen_headers.get("last-event-id").map(|v| v.as_bytes()))
            .or(ontogen_query.resume);
    let ontogen_rx = ontogen_state
        .subscribe_activity_for_kind_for(&ontogen_scope, kind, ontogen_resume)
        .await
        .map_err(ontogen_app_error)?;
    Ok(ontogen_sse_stream("activity-for-kind", ontogen_rx, ontogen_core::events::seq_id, ontogen_result_frame))
}

async fn log_lines_sse_scoped(
    State(ontogen_state): State<Arc<AppState>>,
    Path(ontogen_scope): Path<uuid::Uuid>,
    ontogen_query: Result<axum::extract::Query<ActivityLogLinesEventQuery>, QueryRejection>,
) -> Result<Sse<impl futures::Stream<Item = Result<Event, Infallible>>>, ErrorObject> {
    let axum::extract::Query(ontogen_query) = ontogen_query.map_err(ontogen_query_rejection)?;
    let ontogen_rx =
        ontogen_state.subscribe_log_lines_for(&ontogen_scope, ontogen_query.level).map_err(ontogen_internal_error)?;
    Ok(ontogen_sse_stream("log-lines", ontogen_rx, ontogen_core::events::no_id, ontogen_result_frame))
}

/// Generated routes. Call this from your main router.
pub fn entity_routes() -> Router<Arc<AppState>> {
    Router::new()
        .route("/api/workouts/version", get(workout_get_version).fallback(allow([Method::GET])))
        .route("/api/events/task-changed", get(task_changed_sse).fallback(allow([Method::GET])))
        .route("/api/events/activity-for-kind/{kind}", get(activity_for_kind_sse).fallback(allow([Method::GET])))
        .route("/api/events/log-lines", get(log_lines_sse).fallback(allow([Method::GET])))
        .route("/api/projects/{project_id}/agents", get(agent_list_scoped).fallback(allow([Method::GET])))
        .route(
            "/api/projects/{project_id}/epics",
            get(epic_list_scoped).post(epic_create_scoped).fallback(allow([Method::GET, Method::POST])),
        )
        .route(
            "/api/projects/{project_id}/epics/{id}",
            get(epic_get_by_id_scoped).patch(epic_update_scoped).delete(epic_delete_scoped).fallback(allow([
                Method::GET,
                Method::PATCH,
                Method::DELETE,
            ])),
        )
        .route(
            "/api/projects/{project_id}/reports",
            get(report_list_scoped).post(report_create_scoped).fallback(allow([Method::GET, Method::POST])),
        )
        .route(
            "/api/projects/{project_id}/reports/{id}",
            get(report_get_by_id_scoped).patch(report_update_scoped).delete(report_delete_scoped).fallback(allow([
                Method::GET,
                Method::PATCH,
                Method::DELETE,
            ])),
        )
        .route(
            "/api/projects/{project_id}/tags",
            get(tag_list_scoped).post(tag_create_scoped).fallback(allow([Method::GET, Method::POST])),
        )
        .route(
            "/api/projects/{project_id}/tags/{id}",
            get(tag_get_by_id_scoped).patch(tag_update_scoped).delete(tag_delete_scoped).fallback(allow([
                Method::GET,
                Method::PATCH,
                Method::DELETE,
            ])),
        )
        .route(
            "/api/projects/{project_id}/tasks",
            get(task_list_scoped).post(task_create_scoped).fallback(allow([Method::GET, Method::POST])),
        )
        .route(
            "/api/projects/{project_id}/tasks/{id}",
            get(task_get_by_id_scoped).patch(task_update_scoped).delete(task_delete_scoped).fallback(allow([
                Method::GET,
                Method::PATCH,
                Method::DELETE,
            ])),
        )
        .route(
            "/api/projects/{project_id}/tasks/list-overdue/{before}",
            get(task_list_overdue_scoped).fallback(allow([Method::GET])),
        )
        .route(
            "/api/projects/{project_id}/tasks/{id}/relationships/{rel}",
            get(ontogen_task_relationship_get_scoped)
                .patch(ontogen_task_relationship_patch_scoped)
                .post(ontogen_task_relationship_post_scoped)
                .delete(ontogen_task_relationship_delete_scoped)
                .fallback(allow([Method::GET, Method::PATCH, Method::POST, Method::DELETE])),
        )
        .route(
            "/api/projects/{project_id}/tasks/{id}/{rel}",
            get(ontogen_task_related_get_scoped).fallback(allow([Method::GET])),
        )
        .route(
            "/api/projects/{project_id}/workouts/summary/{id}",
            get(workout_get_summary_scoped).fallback(allow([Method::GET])),
        )
        .route("/api/projects/{project_id}/workouts/start", post(workout_start_scoped).fallback(allow([Method::POST])))
        .route(
            "/api/projects/{project_id}/workouts/rename",
            post(workout_rename_scoped).fallback(allow([Method::POST])),
        )
        .route("/api/projects/{project_id}/workouts/pause", post(workout_pause_scoped).fallback(allow([Method::POST])))
        .route(
            "/api/projects/{project_id}/workouts/{parent_id}/labels",
            get(workout_list_labels_scoped).post(workout_add_label_scoped).fallback(allow([Method::GET, Method::POST])),
        )
        .route(
            "/api/projects/{project_id}/workouts/{parent_id}/labels/{child_id}",
            delete(workout_remove_label_scoped).fallback(allow([Method::DELETE])),
        )
        .route(
            "/api/projects/{project_id}/events/task-changed",
            get(task_changed_sse_scoped).fallback(allow([Method::GET])),
        )
        .route(
            "/api/projects/{project_id}/events/activity-for-kind/{kind}",
            get(activity_for_kind_sse_scoped).fallback(allow([Method::GET])),
        )
        .route("/api/projects/{project_id}/events/log-lines", get(log_lines_sse_scoped).fallback(allow([Method::GET])))
}
